<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/admin_background"
    android:orientation="vertical"
    android:padding="@dimen/screen_padding">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/onboarding_overlay_title"
        android:textColor="@color/admin_text_primary"
        android:textSize="@dimen/title_text"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/onboarding_overlay_description"
        android:textColor="@color/admin_text_secondary"
        android:textSize="@dimen/body_text" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/onboarding_overlay_steps"
        android:textColor="@color/admin_text_secondary"
        android:textSize="@dimen/body_text" />

    <TextView
        android:id="@+id/tvOverlayStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:textColor="@color/status_bad"
        android:textSize="@dimen/body_text" />

    <TextView
        android:id="@+id/tvOverlayWarning"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/onboarding_overlay_warning"
        android:textColor="@color/status_bad"
        android:textSize="@dimen/body_text" />

    <Button
        android:id="@+id/btnOpenOverlaySettings"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:background="@drawable/bg_admin_button"
        app:backgroundTint="@null"
        android:paddingHorizontal="28dp"
        android:paddingVertical="10dp"
        android:text="@string/onboarding_open_settings"
        android:textColor="@color/white"
        android:textSize="@dimen/body_text" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:orientation="horizontal">
        <Button
            android:id="@+id/btnOverlayBack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_admin_button"
            app:backgroundTint="@null"
            android:paddingHorizontal="24dp"
            android:paddingVertical="10dp"
            android:text="@string/onboarding_back"
            android:textColor="@color/white"
            android:textSize="@dimen/body_text" />
        <Button
            android:id="@+id/btnOverlayNext"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:background="@drawable/bg_admin_button"
            app:backgroundTint="@null"
            android:enabled="false"
            android:paddingHorizontal="24dp"
            android:paddingVertical="10dp"
            android:text="@string/onboarding_next"
            android:textColor="@color/white"
            android:textSize="@dimen/body_text" />
    </LinearLayout>
</LinearLayout>
