    <!-- Services and notifications -->
    <string name="accessibility_service_description">KidLock service for controlling app usage time on Android TV. Enable this service for automatic app blocking when time runs out. Without this service, the app cannot block access to other apps.</string>
    <string name="time_limit_reached">Time limit reached</string>
    <string name="time_limit_reached_message">TV usage time is over. Enter a code to continue.</string>
    <string name="time_limit_notifications">Time limit notifications</string>
    <string name="accessibility_instructions">To enable app blocking, you need to turn on Accessibility Service:\n\n1. Press the \"Configure Accessibility Service\" button\n2. Find \"KidLock\" in the services list\n3. Turn on the toggle next to KidLock\n4. Confirm enabling the service\n\nOnce enabled, the service will automatically block apps when time runs out.</string>
    <string name="usage_stats_instructions">To track app usage time, you need to grant Usage Stats permission:\n\n1. Press the \"Configure Usage Stats\" button\n2. Find \"KidLock\" in the apps list\n3. Turn on \"Allow usage access\"\n4. Return to the app\n\nWithout this permission, the app cannot track usage time of other apps.</string>

